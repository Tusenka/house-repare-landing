# Копия и SMTP-настройки для отправки заявок на почту
# COPY to .env.local and fill in real values.

# Отправитель (аккаунт Yandex, от которого шлём письма)
SMTP_USER=example@yandex.ru
SMTP_PASS=your-app-password
EMAIL_FROM=Aleksej <example@yandex.ru>

# Куда уходят заявки на обратный звонок
CONTACT_EMAIL=Oavrabota@yandex.ru

# SMTP-сервер (yandex по умолчанию)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
